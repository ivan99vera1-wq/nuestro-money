# ============================================================================
# NUESTRO MONEY — Environment variables
# ============================================================================
#
# Copy this file to `.env.local` for local development and fill in the values.
# NEVER commit `.env.local` or any real key to the repository (see .gitignore).
#
# IMPORTANT ON SECURITY
# ---------------------
# `VITE_*` variables are PUBLIC: they are embedded in the client bundle and
# shipped to the browser. They must NEVER hold secrets.
#
# The Supabase ANON KEY is safe to expose because Row Level Security (RLS)
# protects every table in the database. An anon key alone can read nothing.
#
# Never put the SERVICE ROLE key, database password, or any admin token here.

# ---------------------------------------------------------------------------
# Supabase (public, RLS-protected)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Anon/public API key (NOT the service_role key)
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# App metadata (optional)
# ---------------------------------------------------------------------------
# Version string shown in the app's profile screen.
VITE_APP_VERSION=1.0.0
